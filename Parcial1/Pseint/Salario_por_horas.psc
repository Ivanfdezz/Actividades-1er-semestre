Algoritmo Salario_por_horas
	Definir horas_de_trabajo, tarifa_de_pago Como Entero
	
	tarifa_de_pago <- 200
	
	Escribir 'Por favor ingrese sus horas de trabajo'
	
	Leer horas_de_trabajo
	
	pago_por_hora <- tarifa_de_pago*horas_de_trabajo
	
	Escribir 'Su pago por hora sera:', pago_por_hora
	
FinAlgoritmo
